# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API (or "API Keys" / "Data API").
# Local development uses the STAGING project (usnjrpnwhqascimtbzqk), never production.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret! Server-only. Used to write the email log.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend → API Keys
RESEND_API_KEY=re_xxx
# Until IT verifies our domain, use onboarding@resend.dev (it only delivers to the Resend account owner)
EMAIL_FROM="Marketing Design Hub <onboarding@resend.dev>"

# When true, every email goes to EMAIL_TEST_RECIPIENT instead of the real recipients
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENT=erylljanna.ong@stratpoint.com

# The address of the app (used in email buttons and login links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
